{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "therecap-web",
  "main": "web.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "recap.filternode.dev", "custom_domain": true, "zone_name": "filternode.dev" }
  ],
  "assets": {
    "directory": "../dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/.netlify/*",
      "/creators",
      "/creators/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "vars": {
    "APP_URL": "https://recap.filternode.dev",
    "CONTEXT": "production",
    "HOSTING_MODE": "shadow",
    "RELEASE_SHA": "0000000000000000000000000000000000000000",
    "APIFY_RUNTIME_ENABLED": "false",
    "HOURLY_COLLECTION_ENABLED": "false",
    "CONTENT_ANALYSIS_ENABLED": "false",
    "AUTOMATIC_CONTENT_ENABLED": "false",
    "SOCIAL_COLLECTION_ENABLED": "false",
    "SOCIAL_CONTENT_ENABLED": "false",
    "DAILY_BRIEFING_ENABLED": "false",
    "REMINDER_EMAIL_ENABLED": "false",
    "KEYWORD_LEARNING_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "LIMIT_ADMIN",
      "namespace_id": "31001",
      "simple": {
        "limit": 90,
        "period": 60
      }
    },
    {
      "name": "LIMIT_CATALOGUE",
      "namespace_id": "31002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "LIMIT_COLLECT",
      "namespace_id": "31003",
      "simple": {
        "limit": 40,
        "period": 60
      }
    },
    {
      "name": "LIMIT_COLLECTION_ACTIVITY",
      "namespace_id": "31004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LIMIT_SOURCE_METADATA",
      "namespace_id": "31005",
      "simple": {
        "limit": 40,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": []
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "therecap-jobs"
      }
    ],
    "consumers": []
  }
}
