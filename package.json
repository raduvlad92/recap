{
  "name": "recap",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run catalogue:check && npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:netlify": "netlify dev",
    "catalogue:check": "node scripts/build-catalogue.mjs --check",
    "catalogue:build": "node scripts/build-catalogue.mjs"
  },
  "dependencies": {
    "@clerk/react": "6.18.0",
    "@fontsource/onest": "5.3.1",
    "@supabase/supabase-js": "2.118.0",
    "fast-xml-parser": "5.11.2",
    "jose": "6.2.13",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.3",
    "@netlify/vite-plugin": "3.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "netlify-cli": "27.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
