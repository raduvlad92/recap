{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "netlify",
    "tests",
    "scripts/keyword-learning.mts",
    "scripts/run-capped-video-analysis-proof.mts",
    "vite.config.ts",
    "cloudflare",
    "vite.cloudflare.config.ts",
    "containers"
  ]
}
